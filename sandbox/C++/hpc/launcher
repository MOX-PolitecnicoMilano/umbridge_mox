export HOME=/u/formaggia
source /u/formaggia/.bashrc

# Versione allineata a quella nel container (MPICH 4.1.2)
spack load mpich@4.1.2

cd /u/formaggia/sandbox

# --- Diagnostica ---
echo "Nodo: $(hostname)"
